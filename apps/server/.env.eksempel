# Kopier til .env og tilpass.
DATABASE_URL=postgres://tilbud:tilbud@localhost:5432/tilbud
PORT=3001
# 127.0.0.1 = bare denne PC-en. Sett 0.0.0.0 for å la kolleger på samme nettverk åpne appen.
HOST=127.0.0.1
# Mappe for opplastede dokumenter (lokal lagring i v1).
DOKUMENTMAPPE=../../data/dokumenter
# Innlogging i utvikling: e-post til brukeren som er logget inn når nettleseren ikke sender noe annet.
DEV_BRUKER_EPOST=kalkulator@eksempel.no
