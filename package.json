{
  "name": "tilbudsevaluering",
  "private": true,
  "version": "0.1.0",
  "description": "Evaluering av tilbud fra underentreprenører og leverandører",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrer": "npm run migrer -w apps/server",
    "db:seed": "npm run seed -w apps/server",
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run build && npm run start -w apps/server",
    "db:start": "docker compose up -d db"
  },
  "engines": {
    "node": ">=20"
  }
}
